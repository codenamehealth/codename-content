front.net/company/QPKAzz/images/fc3047fc-bb37-4732-a749-89d626527964.png') top center repeat;background-size:394px auto;border:2px solid #08070a;border-radius:14px;box-shadow:inset 0 0 34px 8px rgba(0,0,0,0.72), inset 0 0 4px 1px rgba(0,0,0,0.9);padding:14px;\">\n<table cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"max-width:600px;width:100%;margin:0 auto;\" width=\"600\">\n<tr><td style=\"padding:0 0 16px;\"><div style=\"background-color:#141317;background-color:rgba(16,15,19,0.96);border:1.5px solid rgba(242,239,230,0.25);border-radius:22px;padding:16px 10px;text-align:center;\"><a href=\"https://codenamehealth.com\" style=\"display:block\"><img alt=\"Code Name\" src=\"https://d3k81ch9hvuctc.cloudfront.net/company/QPKAzz/images/2437da06-7516-402a-a598-e7b4aad84dbd.png\" style=\"display:block;image-rendering:pixelated;margin:0 auto;\" width=\"220\"/></a></div></td></tr>\n<tr><td style=\"padding:0 0 16px;\"><div style=\"background-color:#141317;background-color:rgba(16,15,19,0.9);border:1.5px solid rgba(232,182,76,0.65);border-radius:22px;box-shadow:0 0 18px 2px rgba(232,182,76,0.3);padding:18px 10px 16px;text-align:center;\"><a href=\"https://codenamehealth.com/pages/side-quest\" style=\"display:block;text-decoration:none\"><img alt=\"The Side Quest dragon on its hoard\" src=\"https://cdn.klaviyomail.com/company/QPKAzz/images/69adfe13-72ea-4e7b-aa96-38d5b9cf9079.gif\" style=\"display:block;image-rendering:pixelated;margin:0 auto;\" width=\"210\"/></a><div style=\"font-family:'Press Start 2P','Courier New',monospace;font-size:15px;line-height:1.6;color:#e8b64c;padding-top:12px;\">SIDE QUEST</div></div></td></tr>\n<tr><td style=\"padding:0 0 16px;\"><div style=\"background-color:#1F1E22;background-color:rgba(24,23,28,0.82);border:1.5px solid rgba(232,182,76,0.5);border-radius:22px;box-shadow:0 0 14px 1px rgba(232,182,76,0.25);padding:24px 26px 22px;\"><div style=\"font-family:'Press Start 2P','Courier New',monospace;font-size:12px;line-height:1.8;color:#e8b64c;text-align:center;\">YOU'RE IN, AND THE ENTRY WAS THE LAST STEP!</div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">From here on, a marble with your name on it rolls in Side Quest every month.</div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">Which race comes first depends on timing.</div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">Entered before midnight ET on the last day of the month? You're in this month's race. Entered after? Your marble rolls in the next one.</div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">Either way, the show goes up on the 1st and the link reaches you that morning.</div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">It runs as five heats, then a final.</div></div></td></tr>\n<tr><td style=\"padding:0 0 16px;\"><div style=\"background-color:#1F1E22;background-color:rgba(24,23,28,0.82);border:1.5px solid rgba(232,182,76,0.5);border-radius:22px;box-shadow:0 0 14px 1px rgba(232,182,76,0.25);padding:24px 26px 22px;\"><img alt=\"A founder box opening: trading cards, a console and a controller rise out\" src=\"https://cdn.klaviyomail.com/company/QPKAzz/images/74eda627-25df-47fa-812c-f07a158d70fe.gif\" style=\"display:block;image-rendering:pixelated;margin:0 auto 6px;\" width=\"170\"/><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;\">Each heat winner takes home a founder box:</div><table cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin-top:6px;\" width=\"100%\"><tr><td style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;color:#e8b64c;padding-top:6px;\" valign=\"top\" width=\"18\">\u2022</td><td style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;font-weight:bold;padding-top:6px;\">All four charms (ACV, creatine, mushroom complex, melatonin)</td></tr><tr><td style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;color:#e8b64c;padding-top:6px;\" valign=\"top\" width=\"18\">\u2022</td><td style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;font-weight:bold;padding-top:6px;\">A map of the Realm, from the Forest of Thornberry to the Moon Temple</td></tr><tr><td style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;color:#e8b64c;padding-top:6px;\" valign=\"top\" width=\"18\">\u2022</td><td style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;font-weight:bold;padding-top:6px;\">A trading card and sticker pack</td></tr></table><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">The five heat winners then race for the grand prize, a Nintendo Switch.</div></div></td></tr>\n<tr><td style=\"padding:0 0 16px;\"><div style=\"background-color:#1F1E22;background-color:rgba(24,23,28,0.82);border:1.5px solid rgba(232,182,76,0.8);border-radius:22px;box-shadow:0 0 20px 2px rgba(232,182,76,0.4);padding:24px 26px 22px;\"><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;\">There's no purchase necessary to enter or win.</div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\"><a href=\"https://codenamehealth.com/pages/the-world#sidequest\" style=\"color:#e8b64c;text-decoration:underline;font-weight:bold;\">Every quest has rules. These are ours.</a></div><div style=\"font-family:'Courier New',Courier,monospace;font-size:14px;line-height:1.6;color:#f2efe6;padding-top:14px;\">We'll be racing your marble on the 1st. Don't miss it.</div></div></td></tr>\n<tr><td style=\"padding:0;\"><div style=\"background-color:#1F1E22;background-color:rgba(24,23,28,0.82);border:1.5px solid rgba(232,182,76,0.4);border-radius:22px;padding:16px 22px 14px;\"><div style=\"font-family:'Press Start 2P','Courier New',monospace;font-size:11px;line-height:1.9;color:#e8b64c;\">BENNETT &amp; VITO</div></div></td></tr>\n<tr><td align=\"center\" style=\"padding:18px 24px 4px;font-family:'Courier New',Courier,monospace;font-size:10px;line-height:1.7;color:#8a8594;\">\n<div style=\"padding-bottom:10px;\">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</div>\nCode Name<br/>1509 West Cypress St, Tampa, FL 33606<br/>\n<a href=\"{% unsubscribe_link %}\" style=\"color:#8a8594;text-decoration:underline\">Unsubscribe</a>\n</td></tr>\n</table></div></div></div>\n</td></tr></tbody></table>\n</div></div>\n</body></html>"
